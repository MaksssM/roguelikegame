static func t(id: String) -> String:
	if STRINGS.has(code) and (STRINGS[code] as Dictionary).has(id):
		return str(STRINGS[code][id])
	if (STRINGS["uk"] as Dictionary).has(id):
		return str(STRINGS["uk"][id])
	return id
